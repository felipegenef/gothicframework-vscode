{
  "Gothic API Route": {
    "prefix": "gar",
    "body": [
      "package api",
      "",
      "import (",
      "\t\"encoding/json\"",
      "\t\"net/http\"",
      "",
      "\troutes \"github.com/felipegenef/gothicframework/pkg/helpers/routes\"",
      ")",
      "",
      "type ${1:RouteName}Response struct {",
      "\tMessage string `json:\"message\"`",
      "}",
      "",
      "var ${1:RouteName}Config = routes.ApiRouteConfig{",
      "\tHttpMethod: routes.GET,",
      "\tType:       routes.DYNAMIC,",
      "}",
      "",
      "func ${1:RouteName}(w http.ResponseWriter, r *http.Request) {",
      "\tresponse, _ := json.Marshal(${1:RouteName}Response{",
      "\t\tMessage: \"Hello World from GOTH API ROUTE\",",
      "\t})",
      "",
      "\tw.Header().Set(\"Content-Type\", \"application/json\")",
      "\tw.WriteHeader(http.StatusOK)",
      "\tw.Write(response)",
      "}"
    ],
    "description": "Generate a Gothic Framework API route"
  },
  "Gothic Topic Definition": {
    "prefix": "gtd",
    "body": [
      "type ${1:TopicName} struct {",
      "\tIntValue     int",
      "\tStringValue  string",
      "\tFloat32Value float32",
      "}",
      "",
      "var _ = CreateTopic(${1:TopicName}{}, TopicConfig{",
      "\tName:             \"${2:topic-name}\",",
      "\tCompression:      BROTLI,",
      "\tSubscriberFnName: \"${3:${1:TopicName}Topic}\",",
      "\tComponentFnName:  \"${4:Add${1:TopicName}Topic}\",",
      "})$0"
    ],
    "description": "Generate a Gothic Framework topic definition"
  }
}
